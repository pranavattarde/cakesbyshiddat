POSTGRES_DB=cakesbyshiddat
POSTGRES_USER=cakes_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
CORS_ORIGINS=https://cakesbyshiddat.com,https://www.cakesbyshiddat.com,https://admin.cakesbyshiddat.com
ENABLE_SWAGGER=false
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
MEDIA_MAX_FILE_SIZE=10485760
PUBLIC_API_URL=https://api.cakesbyshiddat.com/api
PUBLIC_SITE_URL=https://cakesbyshiddat.com
# Used only when intentionally running the seed command from a trusted host.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-initial-password
